{
  "name": "faturoice",
  "productName": "Faturoice Vintage",
  "version": "1.0.1",
  "description": "Program per menaxhimin dhe printimin e faturave",
  "author": "Admin",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.faturoice.app",
    "productName": "Faturoice Vintage",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "invoice.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "templates/",
        "to": "templates/"
      }
    ]
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^26.15.3"
  }
}